#!/usr/bin/env bash
powershell.exe -NoProfile -Command '$os=Get-CimInstance Win32_OperatingSystem; $total=[math]::Round($os.TotalVisibleMemorySize/1MB,1); $free=[math]::Round($os.FreePhysicalMemory/1MB,1); $used=[math]::Round($total-$free,1); Write-Host "              total        used        free"; Write-Host (("Mem:       {0,8}G    {1,8}G    {2,8}G" -f $total,$used,$free))'
