#!/usr/bin/env bash

printf '%s\n' 'Git Bash Linux-Like Environment Check'
printf '%s\n' '====================================='

check() {
    local name="$1"
    if command -v "$name" >/dev/null 2>&1; then
        printf '  [OK]   %-12s %s\n' "$name" "$(command -v "$name")"
    else
        printf '  [MISS] %-12s\n' "$name"
    fi
}

for c in bash git ls grep sed awk find tar gzip ssh curl vim apt apt-get man ifconfig ip free open linux-help nano wget jq sudo; do
    check "$c"
done

echo
if command -v winget.exe >/dev/null 2>&1 || command -v winget >/dev/null 2>&1; then
    echo "  [OK]   WinGet backend detected"
else
    echo "  [WARN] WinGet backend not detected; apt install will not work."
fi

echo
echo "If nano/wget/jq were just installed but show [MISS], run:"
echo "  refreshpath"
echo "or close and reopen Git Bash."
